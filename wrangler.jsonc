{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karmijnsimons",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only the form endpoint runs code; every page is served straight from the static assets.
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare Email Service. Locked to Karmijn's address so the form can't be used to mail anyone else.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["hi@karmijnsimons.com", "karmijn@studioheem.com"],
      "remote": true
    }
  ]
}

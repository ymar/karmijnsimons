---
import { Image } from 'astro:assets';
import mark from '../assets/brand/mark-white.png';

const links = [
  { href: '/about', label: 'About' },
  { href: '/work', label: 'Work' },
  { href: '/contact', label: 'Contact' },
  { href: 'https://www.instagram.com/karmijnsimons/', label: 'Instagram' },
];
---

<footer class="bg-wine px-6 pt-[71px] pb-[60px] text-white md:px-[60px] md:py-[89px] lg:px-[100px]">
  <div class="flex flex-col items-center gap-[47px] md:flex-row md:justify-between md:gap-8">
    <a href="/" class="flex items-center gap-2.5">
      <Image src={mark} alt="" width={26} height={20} class="h-[19px] w-[26px] object-cover" />
      <span class="font-serif text-[18px] leading-[1.2] tracking-[-0.036em] italic lg:text-[22px]">Karmijn Simons</span>
    </a>
    <nav class="flex flex-col items-center gap-8 md:flex-row" aria-label="Footer">
      {links.map((l) => (
        <a
          href={l.href}
          class="font-display text-[16px] leading-[1.2] tracking-[-0.02em] text-white/60 transition-colors hover:text-white"
          {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
        >
          {l.label}
        </a>
      ))}
    </nav>
  </div>
</footer>

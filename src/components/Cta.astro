---
import Triangle from './Triangle.astro';
---

<section class="bg-pink px-6 pt-[71px] pb-[83px] md:pt-[109px] md:pb-[81px] lg:pt-[81px] text-center">
  <h2 class="heading-lg mx-auto max-w-[270px] text-wine max-md:leading-[1.5] md:max-w-none">
    Curious to hear what <br class="hidden md:inline" />you’re working on.
  </h2>
  <div class="mt-[31px] flex justify-center">
    <a
      href="/contact"
      class="font-display flex items-center gap-3 rounded-full bg-wine px-[34px] py-[18px] text-[16px] leading-[1.2] tracking-[-0.02em] text-white transition-opacity hover:opacity-90"
    >
      Let's talk <Triangle />
    </a>
  </div>
</section>

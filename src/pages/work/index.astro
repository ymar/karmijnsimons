---
import Base from '../../layouts/Base.astro';
import WorkGrid from '../../components/WorkGrid.astro';
---

<Base>
  <section class="px-6 pt-[208px] text-center md:pt-[160px]">
    <h1 class="heading-xl mx-auto max-w-[342px] md:max-w-[880px]">
      For <em class="text-soft">organizations</em> that <em class="text-soft">care</em> about clarity, inclusion, and people.
    </h1>
  </section>

  <section class="pt-[92px] pb-[72px] md:pt-[76px] md:pb-[56px]">
    <WorkGrid variant="work" />
  </section>
</Base>

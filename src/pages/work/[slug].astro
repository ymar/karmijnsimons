---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site';

export async function getStaticPaths() {
  const items = await getCollection('work');
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const url = `${SITE.url}/work/${item.id}`;
const client = item.data.title.split(' — ')[0];

const schema = [
  {
    '@type': 'CreativeWork',
    '@id': `${url}#work`,
    url,
    name: item.data.title,
    headline: item.data.title,
    description: item.data.description,
    image: new URL(item.data.cover.src, SITE.url).href,
    creator: { '@id': `${SITE.url}/#karmijn` },
    author: { '@id': `${SITE.url}/#karmijn` },
    funder: { '@type': 'Organization', name: client },
    genre: 'Illustration',
    inLanguage: 'en',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Work', item: `${SITE.url}/work` },
      { '@type': 'ListItem', position: 3, name: client, item: url },
    ],
  },
];
---

<Base
  title={`${item.data.title} — Karmijn Simons`}
  description={item.data.description}
  image={item.data.cover}
  imageAlt={item.data.coverAlt}
  type="article"
  schema={schema}
>
  <section class="relative mt-[48px] h-[720px] overflow-hidden bg-[#101010] md:mt-0">
    <Image
      src={item.data.cover}
      alt={item.data.coverAlt}
      widths={[800, 1440, 2048]}
      sizes="100vw"
      class="absolute inset-0 size-full object-cover"
      loading="eager"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-[#101010]/70 via-[#101010]/30 via-50% to-[#101010]/10" aria-hidden="true"></div>
    <div class="absolute inset-x-6 bottom-6 md:inset-x-[60px] md:bottom-[60px] lg:inset-x-[120px] lg:bottom-[95px]">
      <h1 class="heading-xl text-white">{item.data.title}</h1>
    </div>
  </section>

  <article class="case-body mx-auto max-w-[390px] px-[22px] pt-[148px] pb-[147px] md:max-w-[725px] md:px-0 md:pt-[100px] md:pb-[100px] lg:max-w-[1440px] lg:px-[120px]">
    <Content />
  </article>
</Base>

---
import Base from '../layouts/Base.astro';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const field =
  'mt-[10px] block w-full rounded-[10px] bg-[#bbbbbb]/15 p-3 font-sans text-[14px] leading-[1.2] text-[#333] placeholder:text-[#999] outline-none focus:ring-1 focus:ring-[#999]';
const label = 'block font-sans text-[12px] leading-[1.2] font-medium text-[#888]';
---

<Base title="Contact — Karmijn Simons">
  <section class="px-[19px] pt-[151px] pb-[109px] md:px-6 md:pt-[156px] lg:pb-[60px]">
    <h1 class="heading-xl mx-auto text-center md:max-w-[880px] lg:max-w-none">Let’s create something that <em>matters</em>.</h1>

    <form
      id="contact-form"
      class="mx-auto mt-[88px] flex max-w-[496px] flex-col gap-5 md:mt-[120px] lg:mt-[96px]"
      method="post"
      action={endpoint || undefined}
      data-endpoint={endpoint}
    >
      <label class={label}>
        Name
        <input type="text" name="name" placeholder="Jane Smith" autocomplete="name" class={field} />
      </label>
      <label class={label}>
        Email
        <input type="email" name="email" placeholder="jane@example.com" autocomplete="email" class={field} />
      </label>
      <label class={label}>
        How can I help you?
        <textarea name="message" placeholder="text" required rows="5" class:list={[field, 'h-[132px] resize-y']}></textarea>
      </label>
      <!-- Honeypot against spam bots -->
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
      <button
        type="submit"
        class="h-10 w-full rounded-[10px] bg-submit font-sans text-[14px] font-semibold text-white transition-opacity hover:opacity-90 disabled:opacity-60"
      >
        Submit
      </button>
      <p class="form-status hidden text-center font-sans text-[14px] text-[#666]" role="status"></p>
    </form>

    <div class="mt-[60px] text-center">
      <h2 class="heading-md text-hello">Say Hello 👋</h2>
      <a
        href="mailto:hi@karmijnsimons.com"
        class="mt-[14px] inline-block font-serif text-[18px] leading-[1.2] tracking-[-0.036em] text-mail italic lg:text-[22px]"
      >
        hi@karmijnsimons.com
      </a>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const show = (msg: string) => {
      status.textContent = msg;
      status.classList.remove('hidden');
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      if (data.get('_gotcha')) return;
      const endpoint = form.dataset.endpoint;

      // No form backend configured: open the visitor's mail app instead.
      if (!endpoint) {
        const subject = encodeURIComponent(`Website enquiry${data.get('name') ? ` from ${data.get('name')}` : ''}`);
        const body = encodeURIComponent(`${data.get('message')}\n\n${data.get('name') ?? ''}\n${data.get('email') ?? ''}`);
        window.location.href = `mailto:hi@karmijnsimons.com?subject=${subject}&body=${body}`;
        return;
      }

      button.disabled = true;
      try {
        const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        show('Thank you! Your message has been sent.');
      } catch {
        show('Something went wrong. Please email hi@karmijnsimons.com instead.');
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
